# Copy to .env and fill credentials. NEVER commit .env.
COGNODB_URI=bolt+s://YOUR_INSTANCE_ID.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=CHANGE_ME

NEO4J_URI=neo4j+s://CHANGE_ME.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME

MEMGRAPH_URI=bolt://CHANGE_ME
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

FALKORDB_URI=redis://CHANGE_ME:6379
FALKORDB_PASSWORD=

ARANGODB_URL=https://CHANGE_ME
ARANGODB_USER=root
ARANGODB_PASSWORD=CHANGE_ME
ARANGODB_DB=benchmark
